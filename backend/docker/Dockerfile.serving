# ============================================================
# Dockerfile.serving
# AutoMLOps — Real-time Model Serving Container
# Ebin Thomas | Week 1 - 2
# ============================================================
# This container loads a trained model (model.pkl / model.joblib)
# and serves an automatic REST API via FastAPI & Uvicorn.
# It exposes:
#   GET  /health  -> Healthcheck & model metadata
#   POST /predict -> JSON payload with feature inputs -> predictions
# ============================================================

FROM python:3.10-slim

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Serving stack & ML inference libraries
RUN pip install --no-cache-dir \
    fastapi==0.110.0 \
    uvicorn==0.28.0 \
    pydantic==2.6.4 \
    scikit-learn==1.4.0 \
    pandas==2.1.4 \
    numpy==1.26.4 \
    xgboost==2.0.3 \
    lightgbm==4.3.0 \
    joblib==1.3.2

WORKDIR /app

# Copy generic prediction server script
COPY serve.py /app/serve.py

# Expected mount or copy at runtime:
# model.pkl is mounted or copied into /app/model.pkl
# Environment variable MODEL_PATH can override the default location
ENV MODEL_PATH=/app/model.pkl
ENV PORT=8080

EXPOSE 8080

CMD ["uvicorn", "serve:app", "--host", "0.0.0.0", "--port", "8080"]
