# ============================================================
# Dockerfile.runner
# AutoMLOps — Safe Training Container
# Ebin Thomas | Week 1
# ============================================================
# This container is what actually runs the ML engineer's
# uploaded training script (train.py). It is isolated from
# the host — it can't touch anything outside its /workspace
# folder. Joel's runner.py spins this up via subprocess.
# ============================================================

FROM python:3.10-slim

# ── System dependencies ──────────────────────────────────────
# gcc and g++ are needed to compile some ML packages from source
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# ── Python ML libraries ──────────────────────────────────────
# Pre-install all common ML libraries so the user's script
# doesn't need to install anything itself at runtime.
RUN pip install --no-cache-dir \
    pandas==2.1.4 \
    numpy==1.26.4 \
    scikit-learn==1.4.0 \
    xgboost==2.0.3 \
    lightgbm==4.3.0 \
    matplotlib==3.8.2 \
    seaborn==0.13.2 \
    joblib==1.3.2

# ── Working directory ────────────────────────────────────────
# Joel's runner.py mounts the job folder here:
#   docker run -v /path/to/jobs/abc123:/workspace automlops-runner python train.py
# The user's train.py and dataset.csv land in /workspace.
# After the script runs, model.pkl will also appear here.
WORKDIR /workspace

# ── Security: run as non-root user ──────────────────────────
# Don't run as root inside the container — safer default.
RUN useradd --create-home --shell /bin/bash runner
USER runner

# ── Default command ──────────────────────────────────────────
# Joel's runner.py overrides this with: python train.py
# This default is just a safety fallback.
CMD ["python", "--version"]